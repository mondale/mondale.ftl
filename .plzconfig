; Please config file
; Leaving this file as is is enough to use plz to build your project.
; Please will stay on whatever version you currently have until you run
; 'plz update', when it will download the latest available version.
;
; Or you can uncomment the following to pin everyone to a particular version;
; when you change it all users will automatically get updated.
; [please]
; version = 17.31.2

[parse]
preloadsubincludes = ///cc//build_defs:cc

[build]
config = dbg

[Plugin "cc"]
Target = //plugins:cc
CoverageTool = llvm-cov

; Flags for optimized builds (e.g. plz build -c opt)
DefaultOptCppFlags = -std=c++26 -O3 -DNDEBUG -Wall -Werror -Wthread-safety

; Flags for debug builds (e.g. plz build -c dbg)
DefaultDbgCppFlags = -std=c++26 -g -DDEBUG -Wall -Werror -Wthread-safety

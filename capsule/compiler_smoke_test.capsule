namespace test_ns

// Do comments work?
capsule LittlePair {
  u32 crc
  string name
}

capsule PileOfPrimitives {
  u8 u_eight
  i8 i_eight
  u16 u_sixteen
  i16 i_sixteen
  u32 u_thirtytwo
  i32 i_thirtytwo
  u64 u_sixtyfour
  i64 i_sixtyfour
}

capsule FullFeature {
  u32 id
  u16 code
  bool enabled
  string name
  vector<string> items
  PileOfPrimitives nested
  vector<LittlePair> littl_stuff

  @default(42)
  @former_name(legacy_count)
  u32 count

  @retired
  u32 old_field
}
